# Generated OpenAPI specs — written by scripts/openapi/generate.ts with
# yaml.stringify({ lineWidth: 120 }), which is NOT prettier's house style.
# Without this, `prettier --write` (lint-staged on staged *.yaml) reflows the
# whole file into a spurious ~60k-line diff. Edit the generator, not these files.
docs/api/api-v1.yaml
docs/api/internal-api.yaml
docs/api/openapi.yaml

# SIGNED FIXTURES — the signature covers the EXACT manifest bytes, so any
# reformatting invalidates it. Prettier expanded this file from 217 to 255
# bytes on its first commit and silently broke the test that verifies it, which
# is precisely the failure `plugin-sign.mjs` warns about when it prints "serve
# manifest.json BYTE-FOR-BYTE as written". Regenerate these with the signer,
# never by hand.
src/lib/server/plugins/external-install/__fixtures__/signed/

# Helm templates are Go templates, not YAML — prettier cannot parse `{{- … }}` (lint-staged would
# fail the commit or mangle them). Chart values/tests/ci files are plain YAML and stay formatted.
deploy/helm/*/templates/

