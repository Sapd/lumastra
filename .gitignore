# Auto-generated encryption key (LUMASTRA_MASTER_KEY) — NEVER commit a real key
config/master.key
**/master.key

# Plugin-specific config files (contain credentials)
config/plugins/

# External plugin build output
plugins/*/dist/

# Generated third-party license manifest (`npm run licenses`; also produced in the
# Docker build). Regenerated on demand — not committed.
third-party-npm-licenses.json

# License signing secrets (private keys) — NEVER commit
licensing-secrets/

# Python bytecode cache (sonic-embedder worker)
__pycache__/
*.pyc
tests/fixtures/test-video-long.mp4

# Synthetic routes created by scripts/typecheck/headroom-check.mjs. Gitignored so an
# interrupted probe can never leak routes into a commit.
src/routes/__typecheck_probe__/

# Generated tone/chirp fixtures + the bundled scheduler for the gapless boundary
# harness (scripts/gapless-harness). Re-created by run.mjs on every run — the
# bundle deliberately so, since a stale one would measure yesterday's scheduler.
scripts/gapless-harness/.fixtures/

# pnpm artifacts. This project builds with npm — `package-lock.json` is the
# committed lockfile and CI/Docker install from it. A stray pnpm lockfile and
# workspace file appeared here (2026-08-25) from a tool reaching for pnpm;
# committing them would give the repo two disagreeing lockfiles. If a pnpm
# migration is ever wanted, that is a deliberate change, not a sweep.
pnpm-lock.yaml
pnpm-workspace.yaml

# Plugin SDK publish output (built by `npm run build:sdk`, never committed)
packages/@sapd/*/dist/

# Fixture dir for the plugin-sign relative-path test (must live under cwd,
# and must not be dot-prefixed, or it cannot reproduce the bug it pins).
tmp-sign-parity-fixture/

# Jellyfin contract suite output (tests/jellyfin-contract/harness.ts)
tests/jellyfin-contract/out/

# Jellyfin contract Kotlin decode project build output
tests/jellyfin-contract/kotlin/build/
tests/jellyfin-contract/kotlin/.gradle/

