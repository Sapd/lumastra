# =============================================================================
# Lumastra - Environment Configuration
# =============================================================================
# Copy this file to `.env` next to docker-compose.yml. Docker Compose reads the
# two passwords below from a file with exactly that name.
#
# This file lists only what has to be set before the app runs, or what cannot
# be set anywhere else. Everything else (integrations, metadata keys, AI
# providers, sign-in with OIDC, feature flags, transcoding tuning, branding,
# navigation) is configured in the setup wizard and under Admin -> Settings.
# Every setting there can also be set here by its variable name; a value set
# here wins and the field in Admin -> Settings becomes read-only.
#
# Full list of environment variables:
#   https://lumastra.org/reference/environment-variables/
# =============================================================================

# =============================================================================
# SECRETS
# =============================================================================
# Passwords for the bundled PostgreSQL and Valkey. docker-compose.example.yml
# uses them for PostgreSQL and both Valkeys and builds all three service URLs,
# and refuses to start while either is empty. Use hex: the values end up in
# connection strings, where '/', '+' and '=' break parsing.
#   openssl rand -hex 24
DATABASE_PASSWORD=
CACHE_PASSWORD=
# Optional: a separate password for the task Valkey (default: CACHE_PASSWORD). Same character rules.
# TASK_CACHE_PASSWORD=

# Encrypts stored secrets (API keys, tokens, webhook secrets). If unset, a key
# is generated into master.key in the config directory (/config in Docker) on
# first start. Either way, keep it stable and back it up: without it, stored
# secrets cannot be decrypted. Set it here when several replicas do not share
# one /config volume. 64 hex characters:
#   openssl rand -hex 32
# LUMASTRA_MASTER_KEY=

# Only for `docker compose --profile sonic up -d`: password of the read-only
# database role used by the sonic music sidecar (see the lumastra-sonic-embedder
# service in docker-compose.example.yml).
# SONIC_READER_PASSWORD=

# Only for `docker compose --profile livetv-proxy up -d`: shared secret between
# the app and the standalone Live TV proxy. The proxy does not start without it.
#   openssl rand -hex 24
# STREAM_PROXY_SECRET=

# =============================================================================
# DATABASE AND CACHE
# =============================================================================
# docker-compose.example.yml supplies DATABASE_URL, CACHE_URL and TASK_CACHE_URL.
# Both web and worker must use the same PostgreSQL and two distinct Valkeys:
# TASK_CACHE_URL is required; there is no fallback to CACHE_URL.
# If CACHE_URL is set, it must name a different server/port, not just another DB.
# CACHE_URL = disposable evictable cache; TASK_CACHE_URL = persistent noeviction
# BullMQ/task/shared coordination. External deployments must set all three URLs.
# DATABASE_URL=postgresql://lumastra:password@postgres:5432/lumastra
# CACHE_URL=redis://default:password@lumastra-valkey-cache:6379/0
# TASK_CACHE_URL=redis://default:password@lumastra-valkey:6379/0
#
# Local source development (docker-compose.dev.yml) exposes task Valkey on 6379
# and cache Valkey on 6380. Uncomment these with your actual password; Compose
# expands ${CACHE_PASSWORD}, while a directly loaded Node .env needs its value:
# CACHE_URL=redis://default:password@localhost:6380/0
# TASK_CACHE_URL=redis://default:password@localhost:6379/0

# =============================================================================
# SERVER
# =============================================================================
# PORT=3000

# Public address of this instance, e.g. https://media.example.com. Must match
# what users type in the browser, or sign-in and other form posts fail with 403.
# Required behind a reverse proxy and on HTTPS: it marks the session cookie
# Secure on every request. Without it, an app sign-in that sends no Origin
# header, through an inner proxy that reports http, can get a cookie without
# Secure. Leave it unset only to reach the app over plain HTTP on your LAN.
# Serve Lumastra at the root of a domain or subdomain; serving it under a path
# (example.com/lumastra/) is not supported.
# ORIGIN=https://media.example.com

# Largest request body the app accepts. The Docker image sets 50M; uploads
# (artwork, avatars, diagnostics) fail with 413 if this or your reverse
# proxy's limit is lower.
# BODY_SIZE_LIMIT=50M

# Caps the Node.js heap and uses fewer Valkey connections, for hosts with
# little memory (under about 4 GB). docker-compose.example.yml sets it to true.
# LUMASTRA_LOW_RAM_MODE=false

# Folders that library folders must live in (comma-separated absolute paths).
# When set, the admin UI cannot add a library folder outside them and the
# folder browser stays inside them. Unset, any existing folder except / can be
# a library folder.
# LIBRARY_ALLOWED_ROOTS=/data,/media

# =============================================================================
# SIGN-IN
# =============================================================================
# Built-in username/password login. The setup wizard creates the first admin
# with it. Keep this line on a fresh install: the startup check refuses to
# boot when no sign-in method is configured. Because it is set here, the
# matching switch in Admin -> Settings is read-only; remove the line once you
# have set up OIDC or forward auth and want to turn built-in login off there.
AUTH_NATIVE_LOGIN_ENABLED=true

# Groups whose members are administrators (comma-separated, case-insensitive).
# With OIDC or forward auth, set this to your identity provider's admin group
# before the first sign-in. Default: admin
# ADMIN_GROUPS=admin

# Reopens /setup on a server that has no administrator left (for example after
# the identity provider stopped sending the admin group). Applies only while
# no administrator exists. Remove it again afterwards.
# SETUP_UNLOCK=1

# =============================================================================
# REVERSE PROXY AND FORWARD AUTH
# =============================================================================
# Setups for nginx, Caddy, Traefik and others:
#   https://lumastra.org/guides/reverse-proxy/
#
# Minimal nginx location:
#   location / {
#       proxy_pass http://127.0.0.1:3000;
#       proxy_set_header Host $host;
#       proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#       proxy_set_header X-Forwarded-Proto $scheme;
#       client_max_body_size 50m;
#       # Drop identity headers a client might send (USERHEADER, GROUPHEADER
#       # and NAMEHEADER below). Required with FORWARD_AUTH_ENABLED=true.
#       proxy_set_header X-Forwarded-User "";
#       proxy_set_header X-Forwarded-Groups "";
#       proxy_set_header X-Authentik-Name "";
#   }

# Comma-separated IPv4 addresses or CIDRs, or exact IPv6 addresses, of your
# reverse proxy. List every proxy hop. Lumastra uses the list to:
#   - read the client address from X-Forwarded-For. When the list is empty,
#     the first X-Forwarded-For entry is believed from any peer; most per-IP
#     rate limits can then be bypassed by changing that header. Sign-in
#     limits, token IP allowlists and stream tokens use the direct peer
#     instead, so behind a proxy they all see the proxy's address;
#   - read X-Forwarded-Proto (decides the Secure flag on session cookies);
#   - accept identity headers, when FORWARD_AUTH_ENABLED=true.
# List only an address that belongs to the proxy alone, such as a proxy
# container's fixed ipv4_address. A LAN range such as 192.168.0.0/16 lets every
# device in it choose its client address and, with FORWARD_AUTH_ENABLED=true,
# sign in as any user; `npm run doctor` and the Security Self-Check warn about
# IPv4 ranges wider than /24. IPv6 ranges are not supported.
# With two proxies (e.g. Cloudflare -> nginx), every hop that adds to
# X-Forwarded-For must be listed, or the outer one counts as the client. Easier:
# let the inner proxy restore the client address (nginx: set_real_ip_from +
# real_ip_header CF-Connecting-IP) and list only the inner proxy.
# A proxy installed on the Docker host connects from the network gateway
# (e.g. 172.18.0.1), which every local program shares.
# TRUSTED_PROXY_IPS=172.28.0.10

# Peers whose X-Forwarded-For / X-Real-IP is believed for the CLIENT ADDRESS ONLY
# (same format as TRUSTED_PROXY_IPS). Unlike TRUSTED_PROXY_IPS they are never
# trusted for forward-auth identity headers. The list is unauthenticated: name
# proxy addresses, never a network (the self-check warns above /24). The Helm
# chart's router needs none of this: it proves itself with a header derived
# from LUMASTRA_MASTER_KEY. Compose users normally want TRUSTED_PROXY_IPS.
# CLIENT_IP_PROXY_IPS=

# Sign users in from the identity headers of a forward-auth proxy (Authentik,
# Authelia, oauth2-proxy and others). Headers are read only from
# TRUSTED_PROXY_IPS, and the proxy must remove copies sent by the client;
# otherwise anyone can send "X-Forwarded-User: admin" and is signed in as
# admin. A username seen for the first time gets a Lumastra account.
# Environment only: Admin -> Settings shows it but cannot change it, and a
# value in settings.json is ignored. Default: false
# FORWARD_AUTH_ENABLED=true

# Header names the proxy uses. GROUPHEADER holds the groups separated by "|"
# or ","; an empty NAMEHEADER ignores the display name.
# USERHEADER=X-Forwarded-User
# GROUPHEADER=X-Forwarded-Groups
# NAMEHEADER=X-Authentik-Name

# Accept identity headers from any peer when TRUSTED_PROXY_IPS is empty. Only
# for a container that untrusted networks cannot reach directly. Default: false
# LUMASTRA_TRUST_ANY_PROXY=false

# Where the "Sign out" button sends the browser, e.g. your identity provider's
# logout URL.
# PUBLIC_LOGOUTURL=https://auth.example.com/logout

# =============================================================================
# TRANSCODING HARDWARE
# =============================================================================
# Software encoding is the default. To use a GPU, set GPU_ACCELERATION and pass
# the device into the container (see the GPU block in
# docker-compose.example.yml and https://lumastra.org/guides/gpu-transcoding/).
# The encoder can also be changed later under Admin -> Settings.
#   none | nvenc (NVIDIA) | qsv (Intel) | vaapi (Intel/AMD on Linux)
#   | amf (AMD on Windows, untested) | videotoolbox (macOS bare metal, untested)
# GPU_ACCELERATION=none
# VAAPI_DEVICE=/dev/dri/renderD128
# QSV_DEVICE=

# The Docker image downloads jellyfin-ffmpeg into /config/bin on first start.
# Set FFMPEG_AUTO_DOWNLOAD=false and point the two paths at your own binaries
# for an offline install. Outside Docker the defaults are `ffmpeg` and
# `ffprobe` on PATH.
# FFMPEG_AUTO_DOWNLOAD=true
# FFMPEG_PATH=/config/bin/ffmpeg
# FFPROBE_PATH=/config/bin/ffprobe

# Working directory for transcoded segments. A tmpfs mount is faster.
# FFMPEG_TRANSCODE_DIR=/tmp/lumastra-transcode

# Decoder and filter threads for analysis-only FFmpeg operations. Default: 2.
# Explicit 0 lets FFmpeg choose automatically (can use substantially more RAM).
# Also editable under Admin -> Settings -> FFmpeg -> Analysis Thread Count.
# Installs with no saved value, including ones that selected the old default 0,
# now use 2. An explicit environment value or saved non-default value is kept.
# Intro analyzer task settings can override the count for its own operations.
# ANALYSIS_FFMPEG_THREADS=2

# Retain immutable browser assets for this many distinct builds (including current).
# Set on the web container; requires persistent /config. Deployment age is irrelevant.
# Replaces the removed ASSET_HISTORY_DAYS window. Minimum 1; default 3.
# ASSET_HISTORY_BUILDS=3

# =============================================================================
# JELLYFIN COMPATIBILITY: CROSS-ORIGIN BROWSER ACCESS
# =============================================================================
# Off by default (empty); native clients and same-origin browsers need no CORS.
# Also editable live in Admin -> Settings -> Connections -> Jellyfin when unset
# here. Exact HTTP(S) origins only, without paths or trailing slashes:
# JELLYFIN_COMPAT_CORS_ORIGINS=https://web.example,https://web2.example:8443
# Explicit '*' allows any origin. Allowed origins can use cross-origin login
# endpoints; with '*' any website can attempt logins and trigger account lockouts.
# /j never accepts cookie authentication or sends Allow-Credentials. Independent
# of native API CORS settings. FEATURE_JELLYFIN_COMPAT=false keeps all /j at 404.
# The earlier unconditional /j wildcard is removed: installs without an explicit
# value now have CORS disabled.
# JELLYFIN_COMPAT_CORS_ORIGINS=
