# Copy to `.env`, then fill the three empty secrets below with fresh random values —
# `docker compose up` refuses to start while any of them is empty. One-liner (macOS + Linux):
#
#   for k in DB_PASSWORD CACHE_PASSWORD LUMASTRA_MASTER_KEY; do
#     sed -i.bak "s/^$k=$/$k=$(openssl rand -hex 32)/" .env; done; rm -f .env.bak
#
# There are deliberately no sample values: a key copied from a public file is a key
# everyone knows.

# --- Datastore passwords (used by docker compose interpolation) ---
DB_PASSWORD=
CACHE_PASSWORD=

# --- Lumastra secrets ---
# Config-decryption key. Losing it makes stored secrets unrecoverable — back up
# the `config` volume. Generate: openssl rand -hex 32
LUMASTRA_MASTER_KEY=
# Token-signing secret. Optional: when unset it is derived from LUMASTRA_MASTER_KEY.
# Set it (openssl rand -hex 32) only if you want to rotate it independently.
# JWT_SECRET=

# Public origin the browser uses (drives SvelteKit origin/CSRF + cookie).
ORIGIN=http://localhost:8080

# Groups that grant admin. The Dex mock connector emits groups=["authors"], so
# this makes that user the first admin.
ADMIN_GROUPS=authors

# --- OIDC (points at the bundled Dex) ---
AUTH_OIDC_ENABLED=true
AUTH_OIDC_ISSUER=http://localhost:5556/dex
AUTH_OIDC_CLIENT_ID=lumastra
# Must match staticClients[].secret in dex-config.yaml.
AUTH_OIDC_CLIENT_SECRET=lumastra-dex-demo-secret-change-me
AUTH_OIDC_SCOPES=openid profile email groups
AUTH_OIDC_GROUPS_CLAIM=groups
AUTH_OIDC_PROVIDER_NAME=Dex
AUTH_OIDC_REDIRECT_URI=http://localhost:8080/auth/oidc/callback
AUTH_OIDC_LINK_BY_VERIFIED_EMAIL=true
# ⚠ Disables TLS verification for ALL OIDC traffic. ONLY for a local plain-HTTP
# test IdP like this one — never set it in production.
AUTH_OIDC_ALLOW_INSECURE=true
