{
    "name": "lumastra",
    "version": "0.1.0",
    "private": true,
    "description": "Self-hosted media platform — movies, series, music and audiobooks from your existing services behind one UI.",
    "license": "AGPL-3.0-only",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Sapd/lumastra.git"
    },
    "bugs": {
        "url": "https://github.com/Sapd/lumastra/issues"
    },
    "homepage": "https://lumastra.org",
    "scripts": {
        "dev": "vite dev",
        "dev:worker": "node --env-file-if-exists=.env scripts/dev-worker.mjs",
        "build": "npm run build:plugins && npm run paraglide:compile && DOTENV_CONFIG_QUIET=true node scripts/increment-sw-version.js && export BUILD_VERSION_TS=$(node -e \"process.stdout.write(String(Date.now()))\") && NODE_OPTIONS='--max-old-space-size=4096' DOTENV_CONFIG_QUIET=true vite build && npm run build:verify && npm run build:sandbox && npm run build:subtitle-worker && npm run build:task-runtime && npm run build:proxy-metadata",
        "paraglide:compile": "npx @inlang/paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale",
        "build:no-sw": "export BUILD_VERSION_TS=$(node -e \"process.stdout.write(String(Date.now()))\") && NODE_OPTIONS='--max-old-space-size=4096' DOTENV_CONFIG_QUIET=true vite build && npm run build:subtitle-worker",
        "build:verify": "npx tsx --tsconfig tsconfig.scripts.json scripts/verify-build-consistency.ts",
        "build:plugins": "npx tsx --tsconfig tsconfig.scripts.json scripts/build-plugins.ts",
        "build:sandbox": "npx tsx --tsconfig tsconfig.scripts.json scripts/build-sandbox.ts",
        "build:subtitle-worker": "node scripts/build-subtitle-worker.mjs",
        "build:watcher": "node scripts/native.mjs build watcher",
        "gen:api-routes": "npx tsx --tsconfig tsconfig.scripts.json scripts/gen-api-routes.ts",
        "gen:api-routes:check": "npx tsx --tsconfig tsconfig.scripts.json scripts/gen-api-routes.ts --check",
        "preview": "vite preview",
        "sw:increment": "node scripts/increment-sw-version.js",
        "check": "npm run check:svelte-types",
        "check:critical": "svelte-kit sync && node scripts/typecheck/svelte-entry-config.mjs && svelte-check --tsgo --tsconfig ./tsconfig.svelte-check.json --threshold error",
        "check:svelte-types": "svelte-kit sync && node scripts/check-svelte-types.mjs",
        "check:native": "svelte-kit sync && svelte-check-native --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && node scripts/typecheck/svelte-entry-config.mjs && svelte-check --tsgo --tsconfig ./tsconfig.svelte-check.json --watch",
        "typecheck": "svelte-kit sync && npm run paraglide:compile && npm run openapi:types && node scripts/typecheck/tsgo-check.mjs",
        "lint": "npm run lint:tiers && npm run lint:callback-safety && npm run lint:fast && npm run lint:typed && npm run lint:tests && npm run lint:headers && npm run lint:copy",
        "lint:tiers": "node scripts/check-lint-tiers.mjs",
        "lint:headers": "node scripts/license-headers.mjs --check",
        "lint:copy": "node scripts/check-operator-copy.mjs",
        "lint:actions": "node scripts/check-actions-pinned.mjs --include-parent",
        "lint:dockerfile-fetches": "node scripts/check-dockerfile-fetches.mjs Dockerfile && node scripts/check-dockerfile-fetches.mjs workers/sonic-embedder/Dockerfile",
        "prelint:fast": "node -e \"const fs=require('fs');const c='.eslintcache-fast',s='src/lib/config/schema.ts';try{if(fs.statSync(s).mtimeMs>fs.statSync(c).mtimeMs)fs.rmSync(c)}catch{}\"",
        "lint:fast": "NODE_OPTIONS='--max-old-space-size=1024' eslint src scripts tests --ignore-pattern 'src/lib/server/services/**' --ignore-pattern 'src/lib/server/database/**' --ignore-pattern 'src/routes/api/**' --ignore-pattern 'src/routes/public-api/**/*.ts' --ignore-pattern 'src/lib/shared/**/*.ts' --ignore-pattern 'src/lib/stores/**/*.ts' --ignore-pattern 'src/lib/utils/**/*.ts' --ignore-pattern 'src/lib/components/**/*.ts' --max-warnings=0 --cache --cache-location .eslintcache-fast --concurrency=4",
        "lint:typed": "npm run paraglide:compile && NODE_OPTIONS='--max-old-space-size=8192 --max-semi-space-size=256' eslint 'src/lib/server/services/**/*.ts' 'src/lib/server/database/**/*.ts' 'src/routes/api/**/*.ts' 'src/routes/public-api/**/*.ts' 'src/lib/shared/**/*.ts' 'src/lib/stores/**/*.ts' 'src/lib/utils/**/*.ts' 'src/lib/components/**/*.ts' --ignore-pattern '**/*.test.ts' --no-error-on-unmatched-pattern --max-warnings=0 --cache --cache-location .eslintcache-typed --concurrency=1",
        "lint:tests": "NODE_OPTIONS='--max-old-space-size=2048' eslint 'src/lib/server/services/**/*.test.ts' 'src/lib/server/database/**/*.test.ts' 'src/routes/api/**/*.test.ts' 'src/routes/public-api/**/*.test.ts' 'src/lib/shared/**/*.test.ts' 'src/lib/stores/**/*.test.ts' 'src/lib/utils/**/*.test.ts' 'src/lib/components/**/*.test.ts' --no-error-on-unmatched-pattern --max-warnings=0 --cache --cache-location .eslintcache-tests --concurrency=4",
        "lint:prettier": "prettier --check . --log-level warn",
        "lint:href": "! grep -rn 'href=\"/' --include='*.svelte' src/ || echo '✓ No static href patterns found (all links use url() helper)'",
        "format": "prettier --write . --log-level warn",
        "test:quarantine-confirmation": "node tests/quarantine-confirmation-layout.browser.mjs",
        "test": "NODE_OPTIONS='--max-old-space-size=8192' vitest run --exclude='**/*.integration.test.ts' && vitest run --config vitest.config.components.ts",
        "test:components": "vitest run --config vitest.config.components.ts",
        "test:batched": "bash scripts/run-tests-batched.sh",
        "test:watch": "NODE_OPTIONS='--max-old-space-size=8192' vitest --exclude='**/*.integration.test.ts'",
        "test:ui": "NODE_OPTIONS='--max-old-space-size=8192' vitest --ui",
        "test:integration": "NODE_OPTIONS='--max-old-space-size=8192' vitest run --config vitest.integration.config.ts",
        "test:jellyfin-contract": "NODE_OPTIONS='--max-old-space-size=8192' vitest run --config tests/vitest/vitest.jellyfin-contract.config.ts",
        "test:integration:disk": "vitest run --config tests/vitest/vitest.integration.disk.config.ts",
        "test:integration:watch": "NODE_OPTIONS='--max-old-space-size=8192' vitest --config vitest.integration.config.ts",
        "test:all": "NODE_OPTIONS='--max-old-space-size=8192' vitest run",
        "db:test:create": "npx tsx --tsconfig tsconfig.scripts.json tests/integration/setup/create-test-db.ts",
        "db:test:drop": "npx tsx --tsconfig tsconfig.scripts.json -e \"require(\"dotenv/config\"); const postgres = require(\"postgres\"); const url = new URL(process.env.DATABASE_URL); url.pathname = \"/postgres\"; const sql = postgres(url.toString()); sql.unsafe(\"DROP DATABASE IF EXISTS lumastra_tests\").then(() => { console.log(\"Dropped lumastra_tests\"); sql.end(); }).catch(e => { console.error(e.message); sql.end(); process.exit(1); });\"",
        "db:test:reset": "npm run db:test:drop && npm run db:test:create",
        "db:test:migrate": "NODE_OPTIONS='--import ./scripts/register-lua.mjs' npx tsx --tsconfig tsconfig.scripts.json tests/integration/setup/run-migrations.ts",
        "test:e2e": "playwright test",
        "test:e2e:livetv": "playwright test -c tests/playwright/playwright.livetv.config.ts",
        "test:e2e:api": "playwright test --project=api",
        "test:e2e:ui": "playwright test --project=ui",
        "test:performance": "NODE_OPTIONS='--max-old-space-size=8192' vitest run --testNamePattern='performance'",
        "benchmark": "npx tsx --tsconfig tsconfig.scripts.json scripts/benchmark-queries.ts",
        "bench": "NODE_OPTIONS='--max-old-space-size=8192' vitest bench --config vitest.integration.config.ts",
        "migrate-schema": "LUMASTRA_MIGRATE_CLI=1 NODE_OPTIONS='--import ./scripts/register-lua.mjs' npx tsx --tsconfig tsconfig.scripts.json src/lib/server/database/migrate-schema.ts",
        "sync-metadata": "LUMASTRA_CLI=sync-metadata npx tsx --tsconfig tsconfig.scripts.json src/lib/server/ai/sync-missing-metadata.ts",
        "sync-tmdb-metadata": "LUMASTRA_CLI=sync-tmdb-metadata npx tsx --tsconfig tsconfig.scripts.json src/lib/server/ai/tmdb-metadata-sync.ts",
        "sync-mdblist": "LUMASTRA_CLI=sync-mdblist npx tsx --tsconfig tsconfig.scripts.json src/lib/server/ai/mdblist-sync.ts",
        "doctor": "npx tsx --tsconfig tsconfig.scripts.json scripts/doctor.ts",
        "migration-status": "NODE_OPTIONS='--import ./scripts/register-lua.mjs' npx tsx --tsconfig tsconfig.scripts.json scripts/migration-status.ts",
        "startup-migration": "NODE_OPTIONS='--import ./scripts/register-lua.mjs' npx tsx --tsconfig tsconfig.scripts.json scripts/startup-migration.ts",
        "cleanup-image-cache": "npx tsx --tsconfig tsconfig.scripts.json scripts/cleanup-image-cache.ts",
        "heal:phantom-files": "npx tsx --tsconfig tsconfig.scripts.json scripts/heal-phantom-files.ts",
        "lint:callback-safety": "node scripts/eslint-plugin-callback-safety/tests/run-tests.js",
        "openapi:generate": "npx tsx --tsconfig tsconfig.scripts.json scripts/openapi/generate.ts",
        "openapi:check": "npx tsx --tsconfig tsconfig.scripts.json scripts/openapi/generate.ts --check",
        "openapi:check-contract": "npx tsx --tsconfig tsconfig.scripts.json scripts/openapi/check-response-contract.ts",
        "check:all": "npm run lint && npm run check:critical && npm run openapi:check && npm run openapi:check-contract",
        "openapi:verify": "npx tsx --tsconfig tsconfig.scripts.json scripts/openapi/verify-spec.ts",
        "openapi:types": "npx openapi-typescript docs/api/openapi.yaml -o src/lib/api/schema.d.ts",
        "verify:schemas": "npx tsx scripts/verify-schema-sync.ts",
        "build:proxy": "node scripts/native.mjs build livetv-proxy && npm run build:proxy-metadata",
        "build:proxy-metadata": "node scripts/build-proxy-metadata.mjs",
        "dev:proxy": "npm run build:proxy && build/lumastra-livetv-proxy --serve",
        "test:proxy": "npm run build:proxy && vitest run --config tests/native-conformance/proxy/vitest.config.ts",
        "build:sdk": "npm --prefix packages/@sapd/lumastra-plugin-sdk run build && npm --prefix packages/@sapd/lumastra-plugin-sdk-testing run build",
        "test:sdk": "vitest run --root packages/@sapd/lumastra-plugin-sdk && vitest run --root packages/@sapd/lumastra-plugin-sdk-testing",
        "test:music-transcode-smoke": "npx tsx --tsconfig tsconfig.scripts.json scripts/smoke-test-music-transcode.ts",
        "licenses": "npx --yes license-checker-rseidelsohn --production --json --excludePrivatePackages --out third-party-npm-licenses.json && echo 'Wrote third-party-npm-licenses.json (production dependency license manifest)'",
        "prepare": "node scripts/prepare-husky.mjs",
        "typecheck:headroom": "svelte-kit sync && npm run paraglide:compile && npm run openapi:types && node scripts/typecheck/headroom-check.mjs",
        "typecheck:resolve-probe": "node scripts/typecheck/resolve-narrowing-probe.mjs",
        "api-recipes:types": "openapi-typescript docs/api/api-v1.yaml --default-non-nullable false -o tests/api-recipes/generated/api-v1.d.ts",
        "test:api-recipes": "vitest run --config tests/vitest/vitest.api-recipes.config.ts",
        "api-snapshots:capture": "npx tsx tests/api-snapshots/capture.ts",
        "api-snapshots:compare": "npx tsx tests/api-snapshots/compare.ts",
        "build:task-runtime": "npx tsx --tsconfig tsconfig.scripts.json scripts/build-task-runtime.ts",
        "native:check": "node scripts/native.mjs check",
        "native:build": "node scripts/native.mjs build",
        "native:licenses": "node scripts/native.mjs licenses",
        "native:smoke": "node scripts/native.mjs smoke",
        "test:queue:postgres": "npm --prefix tests/queue-postgres-pilot test"
    },
    "devDependencies": {
        "@eslint/js": "~10.0.1",
        "@playwright/test": "^1.63.0",
        "@sveltejs/adapter-node": "^5.5.7",
        "@sveltejs/kit": "^2.70.3",
        "@sveltejs/vite-plugin-svelte": "~7.3.1",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/svelte": "^5.4.2",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^25.9.6",
        "@types/ws": "^8.18.2",
        "@typescript-eslint/eslint-plugin": "^8.70.1",
        "@typescript-eslint/parser": "^8.70.1",
        "@typescript/native": "npm:typescript@~7.0.2",
        "@vitest/ui": "^5.0.2",
        "esbuild": "^0.28.2",
        "eslint": "~10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.23.0",
        "fast-check": "^4.10.0",
        "globals": "^17.12.0",
        "happy-dom": "^21.0.4",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "oauth2-mock-server": "^9.2.0",
        "openapi-fetch": "^0.17.0",
        "openapi-typescript": "^7.10.1",
        "prettier": "^3.9.9",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.57.2",
        "svelte-check": "^4.7.8",
        "svelte-check-native": "^1.8.0",
        "svelte-eslint-parser": "^1.8.1",
        "svelte-preprocess-import-assets": "^1.1.0",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.2",
        "vite": "~8.3.5",
        "vitest": "^5.0.2",
        "zod-openapi": "^6.0.2"
    },
    "type": "module",
    "workspaces": [
        "packages/@sapd/*"
    ],
    "engines": {
        "_comment": "Matches Dockerfile (node:24-alpine / node:24-slim / NodeSource node_24.x) + .nvmrc (24); ship an LTS line only — node 25 reached end of life on 2026-06-01. Lumastra has never been tested on <22; the old '>=20.3.0' floor pre-dated the Svelte 5 / Vitest 4 upgrades that assume Node 22+ APIs.",
        "node": ">=22.0.0"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.128.0",
        "@dagrejs/dagre": "^3.1.1",
        "@floating-ui/dom": "^1.8.0",
        "@inlang/paraglide-js": "^2.25.2",
        "@jellyfin/sdk": "^1.0.0",
        "@valkey/valkey-glide": "^2.5.3",
        "akarisub": "^1.1.6",
        "axios": "^1.20.0",
        "blurhash": "^2.0.5",
        "bullmq": "^6.3.15",
        "chart.js": "^4.5.1",
        "chartjs-adapter-date-fns": "^3.0.0",
        "date-fns": "^4.4.0",
        "dompurify": "^3.4.17",
        "dotenv": "^17.4.2",
        "hls.js": "^1.7.3",
        "ioredis": "^6.0.0",
        "jose": "^6.2.12",
        "libbitsub": "^1.13.0",
        "music-metadata": "^11.16.1",
        "openai": "^7.33.0",
        "openid-client": "^6.8.8",
        "postgres": "^3.4.9",
        "prom-client": "^15.1.3",
        "sharp": "^0.35.5",
        "svelte-dnd-action": "^0.9.80",
        "svelte-hero-icons": "^5.2.0",
        "tsx": "4.23.15",
        "ulid": "^3.0.2",
        "undici": "^8.11.2",
        "voyageai": "^0.4.0",
        "ws": "^8.22.0",
        "yaml": "^2.9.1",
        "zod": "^4.6.7"
    },
    "overrides": {
        "cookie": "^0.7.2",
        "qs": "^6.14.1"
    },
    "lint-staged": {
        "*.{js,ts,svelte}": "prettier --write",
        "*.{json,css,md,yaml,yml}": "prettier --write"
    }
}
