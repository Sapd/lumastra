{
    "name": "@sapd/lumastra-plugin-sdk-testing",
    "version": "0.1.0-alpha.1",
    "description": "Testing helpers (mockContext, runTask, expectRun, mock-helpers) for @sapd/lumastra-plugin-sdk plugin authors",
    "license": "Apache-2.0",
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "peerDependencies": {
        "@sapd/lumastra-plugin-sdk": "^0.2.0-alpha.2"
    },
    "devDependencies": {
        "typescript": "*",
        "vitest": "*"
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json",
        "prepublishOnly": "node ../scripts/assert-publish-client.mjs && npm run build"
    },
    "publishConfig": {
        "access": "public",
        "main": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "default": "./dist/index.js"
            }
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Sapd/lumastra.git",
        "directory": "packages/@sapd/lumastra-plugin-sdk-testing"
    }
}
