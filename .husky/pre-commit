. "$(dirname -- "$0")/resolve-app-dir.sh"

if has_node_modules; then
	npx --no lint-staged
else
	echo "pre-commit: lint-staged skipped — $app_dir has no node_modules (run npm ci there to lint staged files)." >&2
fi

# The three OpenAPI specs are one artifact in three projections (one
# `openapi:generate` run writes all of them). Committing a subset publishes a
# contract that disagrees with itself — and because native clients fetch
# api-v1.yaml while this repo reads openapi.yaml, the half that goes missing is
# invisible here and only shows up in a client's resync. Cheap: two `git diff
# --name-only` calls, and it stays silent unless a spec is actually staged.
# Plain node with no dependencies, so it runs in a worktree without node_modules.
node scripts/check-openapi-spec-cohesion.mjs
