# Strips "Co-Authored-By: Claude <...>" trailers from the message file ($1).
# This repo records AI assistance in the pull request instead (the disclosure in
# .github/CONTRIBUTING-AI.md), not in commit trailers.
msg="$1"
tmp="$msg.tmp.$$"
awk '
	tolower($0) ~ /^co-authored-by:[ \t]*claude/ { next }
	{ lines[++n] = $0 }
	END {
		while (n > 0 && lines[n] ~ /^[ \t]*$/) n--
		for (i = 1; i <= n; i++) print lines[i]
	}
' "$msg" > "$tmp"
mv "$tmp" "$msg"
