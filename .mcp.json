{
    "mcpServers": {
        "svelte": {
            "type": "stdio",
            "command": "npx",
            "env": {},
            "args": ["-y", "@sveltejs/mcp@latest"]
        },
        "playwright": {
            "type": "stdio",
            "command": "npx",
            "args": ["@playwright/mcp@latest"]
        }
    }
}
